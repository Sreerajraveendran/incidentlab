# Copy to .env (never commit .env) and change every password.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
PLATFORM_DB_PASSWORD=change-me-platform
APP_VERSION=dev
# Set to true only for the readiness-cascade drill.
READINESS_CHECKS_DB=false
# Host port for NGINX (8080 is often taken on Windows).
MINICLOUD_PORT=8088
# Bearer token for writes (POST/PUT/DELETE). Change it.
API_TOKEN=demo-token
# Lab-only: lets the dashboard simulate cache misses, DB errors, slow network.
SIMULATION_ENABLED=true
